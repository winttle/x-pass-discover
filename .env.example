# ---------------------------------------------------------------------------
# X-PASS Discover — environment
#
# Every value here is OPTIONAL. With an empty .env the app still runs end to
# end: runtime state goes to a local JSON file and the AI runs in mock mode.
# The UI always shows which adapters are actually live, so a missing credential
# is visible rather than silently faked.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string.
# Unset in development → local file store at .data/ (survives restarts).
# Unset in production  → DEMO MODE: everything is held in memory and lost when
#                        the instance recycles. The UI says so on every page.
# Set                  → Drizzle + Neon. Run `npm run db:migrate && npm run db:seed` first.
DATABASE_URL=

# Secret used to sign the session cookie.
# Unset → an insecure development fallback is used. REQUIRED in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# OpenAI credentials for the AI employees.
# Unset → deterministic mock AI (the full scenario is still playable).
OPENAI_API_KEY=

# mock | openai. Unset → openai when OPENAI_API_KEY is present, else mock.
# Setting `openai` without a key falls back to mock and says so in the UI.
X_PASS_AI_MODE=

# Chat model used when X_PASS_AI_MODE resolves to openai.
X_PASS_OPENAI_MODEL=gpt-4o-mini

# Public base URL of the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails allowed into /admin.
# Unset → admin is open to any signed-in user in development, and CLOSED in
# production. Set this before deploying if you need admin access there.
X_PASS_ADMIN_EMAILS=

# Directory for the local file store. Ignored when DATABASE_URL is set.
X_PASS_DATA_DIR=.data
